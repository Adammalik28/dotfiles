 /* wallust template - colors-rofi */

* {
active-background: #D5744B;
active-foreground: #FCEABD;
normal-background: #2B2121;
normal-foreground: #FCEABD;
urgent-background: #EA8253;
urgent-foreground: #FCEABD;

alternate-active-background: #C52237;
alternate-active-foreground: #FCEABD;
alternate-normal-background: #2B2121;
alternate-normal-foreground: #FCEABD;
alternate-urgent-background: #2B2121;
alternate-urgent-foreground: #FCEABD;

selected-active-background: #D5744B;
selected-active-foreground: #2B2121;
selected-normal-background: #D5744B;
selected-normal-foreground: #2B2121;
selected-urgent-background: #C52237;
selected-urgent-foreground: #2B2121;

background-color: #2B2121;
background: rgba(0,0,0,0.7);
foreground: #FCEABD;
border-color: #D5744B;

color0: #524646;
color1: #3B1114;
color2: #723728;
color3: #941A29;
color4: #A05739;
color5: #B0623E;
color6: #B89232;
color7: #F2D898;
color8: #A9976B;
color9: #4F171B;
color10: #974935;
color11: #C52237;
color12: #D5744B;
color13: #EA8253;
color14: #F5C243;
color15: #F2D898;


}

