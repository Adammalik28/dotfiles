{
  "$schema": "/etc/xdg/swaync/configSchema.json",

  "positionX": "center",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "user",

  "control-center-margin-top": 8,
  "control-center-margin-bottom": 10,
  "control-center-margin-right": 0,
  "control-center-margin-left": 0,
  "control-center-exclusive-zone": true,
  "control-center-width": 400,
  "control-center-height": -1,
  "fit-to-screen": false,

  "notification-window-width": 390,
  "notification-2fa-action": true,
  "notification-inline-replies": true,
  "notification-body-image-height": 120,
  "notification-body-image-width": 220,
  "notification-grouping": true,
  "relative-timestamps": true,
  "image-visibility": "when-available",

  "timeout": 6,
  "timeout-low": 4,
  "timeout-critical": 0,
  "transition-time": 220,

  "keyboard-shortcuts": true,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": true,
  "text-empty": "No Notifications",

  "notification-action-filter": {
    "hide-open-button": {
      "use-regex": true,
      "text-matcher": "^(Open|Buka)$"
    }
  },

  "widgets": [
    "dnd",
    "buttons-grid",
    "volume",
    "backlight",
    "mpris",
    "title",
    "notifications"
  ],
  "widget-config": {
    "notifications": {},
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear All"
    },
    "dnd": {
      "text": "Do Not Disturb"
    },
    "mpris": {
      "image-size": 56,
      "image-radius": 10
    },
    "volume": {
      "label": "󰕾"
    },
    "backlight": {
      "label": "󰃟"
    },
    "buttons-grid": {
      "buttons-per-row": 6,
      "actions": [
        {
          "label": "󰐥",
          "command": "bash -c $HOME/.config/hypr/scripts/Wlogout.sh"
        },
        {
          "label": "󰌾",
          "command": "bash -c $HOME/.config/hypr/scripts/LockScreen.sh"
        },
        {
          "label": "󰍃",
          "command": "hyprctl dispatch 'hl.dsp.exit()'"
        },
        {
          "label": "󰀝",
          "command": "bash -c $HOME/.config/hypr/scripts/AirplaneMode.sh"
        },
        {
          "label": "󰝟",
          "command": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
        },
        {
          "label": "󰂯",
          "command": "blueman-manager"
        }
      ]
    }
  }
}
